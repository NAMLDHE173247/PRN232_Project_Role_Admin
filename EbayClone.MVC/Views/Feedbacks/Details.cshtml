@model AdminFeedbackViewModel
@{ ViewData["Title"] = "Feedback Detail"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Feedback #@Model.Id</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
</div>
<div class="panel">
    <div class="row g-3">
        <div class="col-md-3"><span class="text-muted">Seller ID</span><div>@(Model.SellerId?.ToString() ?? "-")</div></div>
        <div class="col-md-3"><span class="text-muted">Rating trung bình</span><div>@(Model.AverageRating?.ToString("0.00") ?? "-")</div></div>
        <div class="col-md-3"><span class="text-muted">Tổng review</span><div>@(Model.TotalReviews?.ToString() ?? "0")</div></div>
        <div class="col-md-3"><span class="text-muted">Tỷ lệ tích cực</span><div>@(Model.PositiveRate?.ToString("0.00") ?? "-")%</div></div>
    </div>
</div>
