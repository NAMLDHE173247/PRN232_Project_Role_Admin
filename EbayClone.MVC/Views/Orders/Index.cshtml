@model PagedViewModel<OrderViewModel>
@{ ViewData["Title"] = "Đơn hàng"; }
<h1 class="page-title">Quản lý đơn hàng</h1>
<form method="get" class="panel mb-3 row g-2 align-items-end">
    <div class="col-sm-4"><label class="form-label" for="status">Status</label><input class="form-control" id="status" name="status" value="@ViewBag.Status" /></div>
    <div class="col-sm-4"><label class="form-label" for="buyerId">Buyer ID</label><input class="form-control" id="buyerId" name="buyerId" type="number" min="1" value="@ViewBag.BuyerId" /></div>
    <div class="col-auto"><button class="btn btn-primary">Lọc</button></div>
</form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Order</th><th>Buyer</th><th>Ngày</th><th>Tổng tiền</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var order in Model.Items)
{
    <tr><td>#@order.OrderId</td><td>@order.BuyerName <span class="text-muted">(@order.BuyerId)</span></td><td>@order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</td><td>@order.TotalAmount.ToString("N0")</td><td><span class="badge-status">@order.Status</span></td><td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@order.OrderId">Chi tiết</a></td></tr>
}
</tbody></table></div>
<div class="mt-3 d-flex justify-content-between"><span class="text-muted">Trang @Model.Page / @Model.TotalPages · @Model.Total bản ghi</span><div class="btn-group"><a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-status="@ViewBag.Status" asp-route-buyerId="@ViewBag.BuyerId">Trước</a><a class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-status="@ViewBag.Status" asp-route-buyerId="@ViewBag.BuyerId">Sau</a></div></div>
