@model PagedViewModel<AdminUserViewModel>
@{ ViewData["Title"] = "Người dùng"; }
<h1 class="page-title">Quản lý người dùng</h1>
<form method="get" class="panel mb-3 row g-2 align-items-end">
    <div class="col-sm-5 col-lg-3">
        <label class="form-label" for="status">Trạng thái</label>
        <select class="form-select" id="status" name="status">
            <option value="">Tất cả</option>
            @foreach (var value in new[] { "Pending", "Active", "Banned" })
            {
                <option value="@value" selected="@(ViewBag.Status == value)">@value</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Lọc</button></div>
</form>
<div class="panel table-responsive">
    <table class="table align-middle">
        <thead><tr><th>ID</th><th>Người dùng</th><th>Role</th><th>Status</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td>@user.Id</td><td><strong>@user.FullName</strong><div class="text-muted small">@user.Email</div></td>
                <td>@user.Role</td><td><span class="badge-status">@user.Status</span></td>
                <td><div class="actions">
                    @if (user.Status == "Pending")
                    { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-success btn-sm">Duyệt</button></form> }
                    @if (user.Status == "Active")
                    { <form asp-action="Block" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@user.Id" /><input class="form-control form-control-sm" name="reason" required maxlength="500" placeholder="Lý do khóa" aria-label="Lý do khóa" /><button class="btn btn-danger btn-sm">Khóa</button></form> }
                    @if (user.Status == "Banned")
                    { <form asp-action="Unblock" method="post"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-outline-success btn-sm">Mở khóa</button></form> }
                </div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="mt-3 d-flex justify-content-between align-items-center">
    <span class="text-muted">Trang @Model.Page / @Model.TotalPages · @Model.Total bản ghi</span>
    <div class="btn-group"><a class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" asp-route-page="@(Model.Page - 1)" asp-route-status="@ViewBag.Status">Trước</a><a class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")" asp-route-page="@(Model.Page + 1)" asp-route-status="@ViewBag.Status">Sau</a></div>
</div>
